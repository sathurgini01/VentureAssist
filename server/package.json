{
  "name": "venture-assist-backend",
  "version": "1.0.0",
  "description": "Venture Assist Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/seeds/createAdmin.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs src/__tests__/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs src/__tests__/integration",
    "test:performance": "npx artillery run artillery.yml",
    "test:performance:report": "npx artillery run artillery.yml --output artillery-report.json && npx artillery report artillery-report.json"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
